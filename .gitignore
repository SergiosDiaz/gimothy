# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
# Mantener .flutter-plugins para que CocoaPods sepa qué plugins instalar
# (NO excluir .flutter-plugins)
.pub/
/build/
/coverage/

# iOS - generados automáticamente (NO excluir Podfile)
ios/Pods/
ios/.symlinks/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/flutter_assets/

# Xcworkspace generado por CocoaPods (usar el del proyecto, no el de pods)
ios/Runner.xcworkspace/xcshareddata/swiftpm/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
